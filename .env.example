# ===== MERU AUTO RECHARGE =====
# Kopye fichye sa a kòm ".env" epi ranpli valè yo.
# PA JANM mete .env sou git / sou frontend la.

# --- Mòd ---
# true = similasyon (default, san danje). false = lajan reyèl.
MOCK_MODE=true

# --- Baz done ---
# Lokal: kite vid (SQLite fichye meru.db kreye otomatikman).
# Vercel: mete baz done ekstèn (serverless pa konsève fichye SQLite!).
#   Turso (rekòmande, konpatib SQLite):
#     DATABASE_URL=sqlite+libsql://<baz>-<org>.turso.io?authToken=<token>&secure=true
#   oswa fòm senp la (mete TURSO_AUTH_TOKEN apa):
#     DATABASE_URL=libsql://<baz>-<org>.turso.io
#     TURSO_AUTH_TOKEN=<token>
#   Supabase (rekòmande): Dashboard -> Connect -> "Transaction pooler"
#     DATABASE_URL=postgresql://postgres.<ref>:<modpas>@aws-0-<rejyonal>.pooler.supabase.com:6543/postgres?sslmode=require
#   Turso (konpatib SQLite):
#     DATABASE_URL=sqlite+libsql://<baz>-<org>.turso.io?authToken=<token>&secure=true
#   oswa fòm senp la (mete TURSO_AUTH_TOKEN apa):
#     DATABASE_URL=libsql://<baz>-<org>.turso.io
DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- PLOP PLOP ---
PLOP_CLIENT_ID=
PLOP_CLIENT_SECRET=
PLOP_BASE_URL=https://plopplop.solutionip.app/

# --- Wallet float (sèlman pou MOD REYÈL) ---
# stellar (USDC, default) oswa trc20 (USDT sou TRON)
WALLET_ASSET=USDC
WALLET_NETWORK=stellar
# Kle prive wallet la. Wallet DEDYE sèlman — mete sèlman sa w dakò riske.
# Pa janm nan baz done, pa janm nan log.
WALLET_SECRET=
# Issuer USDC sou Stellar pubnet (Circle). Pa chanje si w pa konnen.
USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
HORIZON_URL=https://horizon.stellar.org
TRONGRID_API_KEY=

# --- Adrès Meru (whiteliste) ---
# Ou ka mete yo isit oswa nan Paramèt. Verifye nan app Meru a!
MERU_ADDRESS=
MERU_MEMO=

# --- Sekirite ---
# Kle pou siyen sesyon yo. Lokal: otomatik si vid. Vercel: METE YON VALÈ FÒ.
SESSION_SECRET=
# Sekre pou endpoint cron Vercel la (/api/cron/tick). Vercel voye l otomatikman.
CRON_SECRET=

# --- Detay flux ---
PAYMENT_TIMEOUT_MIN=15
MOCK_AUTO_OK_S=15

# --- Notifikasyon (opsyonèl) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
